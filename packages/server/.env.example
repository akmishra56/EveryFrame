# Copy to .env and fill in real values. Never commit .env.

# Session cookie signing secret - must be at least 32 characters.
EVERYFRAME_SESSION_SECRET=change-me-to-a-random-32-plus-character-string

# Chrome DevTools Protocol endpoint - see README.md "Running it" for the platform-specific
# Chrome launch command (macOS/Windows/Linux differ).
EVERYFRAME_CDP_ENDPOINT=http://localhost:9222

# Optional: override the SQLite database file location.
# EVERYFRAME_DB_PATH=./data/everyframe.db

# Serve the backend itself over https (local dev only - matches the frontend's own self-signed
# dev cert). Generate the cert first: npm run generate-cert -w packages/server
# EVERYFRAME_HTTPS=true
# EVERYFRAME_TLS_CERT_PATH=./certs/localhost-cert.pem
# EVERYFRAME_TLS_KEY_PATH=./certs/localhost-key.pem

PORT=4000
NODE_ENV=development
